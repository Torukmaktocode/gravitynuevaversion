{"nodes": [{"id": "docs_instructions_ritmo_comercial_ventas_sostenibles", "label": "Sistema de Conocimiento Comercial para Seguros Falabella", "file_type": "document", "source_file": "docs/instructions/ritmo-comercial-ventas-sostenibles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_portafolio_completo_seguros_falabella", "label": "Portafolio Completo Seguros Falabella", "file_type": "concept", "source_file": "docs/instructions/ritmo-comercial-ventas-sostenibles.md", "source_location": "L3-L6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Playbook comercial convertido en base de conocimiento accionable. Cubre Vehicular (Full Cobertura, Auto Efectivo), Salud (Multisalud Base, Salud Esencial, OncoProtecci\u00f3n Plus), Vida (Vida con Devoluci\u00f3n, Adulto Seguro), Complementos (Dental Chubb, Renta Hospitalaria)."}, {"id": "concept_formula_central_ventas_sostenibles", "label": "F\u00f3rmula: Calidad de Venta + Excelente Experiencia = Resultado Perdurable", "file_type": "concept", "source_file": "docs/instructions/ritmo-comercial-ventas-sostenibles.md", "source_location": "L325", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Principio rector del sistema: la venta sostenible nace de diagnosticar mejor, educar mejor, comparar mejor, cerrar mejor y acompa\u00f1ar mejor. No de presionar."}, {"id": "concept_marco_legal_ventas", "label": "Marco Legal para Ventas Sanas (Condiciones, Carencia, Espera, Arrepentimiento)", "file_type": "concept", "source_file": "docs/instructions/ritmo-comercial-ventas-sostenibles.md", "source_location": "L1043-L1135", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Condiciones generales, particulares y especiales + derecho de arrepentimiento (15 d\u00edas) + preexistencias + periodos de carencia (30 d\u00edas) y espera (10 meses maternidad). Explicar carencia y espera no asusta, genera confianza."}, {"id": "concept_modos_entrenamiento", "label": "Modos de Entrenamiento del Vendedor (B\u00e1sico, Medio, Alto, Gravedad Cero)", "file_type": "concept", "source_file": "docs/instructions/ritmo-comercial-ventas-sostenibles.md", "source_location": "L1267-L1283", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cuatro niveles progresivos: B\u00e1sico (productos), Medio (diagn\u00f3stico+objeciones), Alto (comparaci\u00f3n de precio/postergan), Gravedad Cero (clientes dif\u00edciles con m\u00faltiples objeciones). Pensado como herramienta de entrenamiento progresivo para vendedores."}, {"id": "concept_framework_gravity_venta_consultiva", "label": "Framework Gravity de Venta Consultiva (5 Pasos)", "file_type": "concept", "source_file": "docs/instructions/ritmo-comercial-ventas-sostenibles.md", "source_location": "L1137-L1157", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Diagn\u00f3stico \u2192 Educaci\u00f3n \u2192 Comparaci\u00f3n \u2192 Valor \u2192 Cierre. El vendedor diagnostica necesidad, riesgo, presupuesto; educa en lenguaje simple; compara protegido vs expuesto; muestra costo real; cierra con pregunta de decisi\u00f3n y silencio."}], "edges": [{"source": "docs_instructions_ritmo_comercial_ventas_sostenibles", "target": "docs_instructions_ritmo_comercial", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/instructions/ritmo-comercial-ventas-sostenibles.md", "source_location": null, "weight": 1.0}, {"source": "docs_instructions_ritmo_comercial_ventas_sostenibles", "target": "concept_7_momentos_de_verdad", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/instructions/ritmo-comercial-ventas-sostenibles.md", "source_location": "L69-L323", "weight": 1.0}, {"source": "docs_instructions_ritmo_comercial_ventas_sostenibl